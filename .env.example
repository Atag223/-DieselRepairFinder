# Database (PostgreSQL recommended for production)
DATABASE_URL="postgresql://user:password@localhost:5432/diesel_repair_finder"

# Resend Email API Key (https://resend.com)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Email addresses for notifications
NOTIFY_EMAIL="admin@dieselrepairfinder.com"
FROM_EMAIL="noreply@dieselrepairfinder.com"

# Google Places API Key (https://console.cloud.google.com)
# Required for the provider seeding script (npm run seed:providers)
# Enable "Places API (New)" in your Google Cloud project.
GOOGLE_PLACES_API_KEY="your_google_places_api_key_here"

# Admin Portal Credentials (used to protect /admin routes)
ADMIN_EMAIL="admin@dieselrepairfinder.com"
ADMIN_PASSWORD="change-me-before-deploying"

# Optional: override the session-signing secret (defaults to ADMIN_EMAIL:ADMIN_PASSWORD)
# ADMIN_SESSION_SECRET="a-long-random-secret-string"

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Public app URL (used for Stripe redirect URLs)
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
