// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RequestStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProviderCategory {
  DIESEL_MECHANIC
  MOBILE_TIRE_SERVICE
  HEAVY_DUTY_WRECKER
}

enum ProviderTier {
  FREE
  FEATURED
  PREMIUM
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
}

enum ProviderSource {
  MANUAL
  GOOGLE_PLACES
}

enum LeadStatus {
  SENT
  ACCEPTED
  DECLINED
  NO_RESPONSE
}

enum ClaimStatus {
  UNCLAIMED
  PENDING
  CLAIMED
}

enum ClaimRequestStatus {
  NEW
  CONTACTED
  APPROVED
  DECLINED
}

enum LeadCreditTransactionType {
  FREE_CREDIT
  ADMIN_GRANT
  STRIPE_PURCHASE
  LEAD_DEBIT
  REFUND
}

model ServiceRequest {
  id                String           @id @default(cuid())
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Required fields
  requesterName     String
  requesterEmail    String
  requesterPhone    String
  serviceAddress    String
  issueType         String
  issueDetails      String

  // Optional fields
  requesterCompany  String?
  city              String?
  state             String?
  breakdownNow      Boolean          @default(false)
  truckType         String?
  unitNumber        String?
  roadsideLocation  String?
  specialNotes      String?

  status            RequestStatus    @default(PENDING)
  referenceId       String           @unique @default(cuid())
  requestedCategory ProviderCategory @default(DIESEL_MECHANIC)

  leads             Lead[]

  @@map("DieselRepairRequest")
}

model ServiceProvider {
  id            String           @id @default(cuid())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  businessName  String
  contactName   String?
  phone         String?
  email         String?          @unique
  city          String
  state         String
  serviceRadius Int?
  website       String?
  is24_7        Boolean          @default(false)
  services      String[]
  notes         String?

  active           Boolean          @default(true)
  providerCategory ProviderCategory @default(DIESEL_MECHANIC)

  // Monetization fields (legacy)
  tier                ProviderTier @default(FREE)
  leadsReceived       Int          @default(0)
  freeLeadsRemaining  Int          @default(3)
  totalLeadsCharged   Int          @default(0)

  // Credit-based billing fields
  leadCredits              Int      @default(0)
  freeLeadCreditsIssued    Boolean  @default(false)
  stripeCustomerId         String?
  stripeAccountBalanceCents Int     @default(0)
  billingStatus            String?
  claimedByEmail           String?
  approvedAt               DateTime?
  lastCreditGrantAt        DateTime?

  // Google Places import fields
  googlePlaceId     String?          @unique
  googleMapsUri     String?
  formattedAddress  String?
  latitude          Float?
  longitude         Float?
  source            ProviderSource   @default(MANUAL)
  verificationStatus VerificationStatus @default(UNVERIFIED)

  // Quality / review signals
  rating            Float?
  reviewCount       Int              @default(0)
  isVerified        Boolean          @default(false)
  lastVerifiedAt    DateTime?

  // Claim tracking
  claimedAt         DateTime?
  claimStatus       ClaimStatus      @default(UNCLAIMED)

  // Suspend / soft-delete tracking
  suspendedAt       DateTime?
  suspendedReason   String?
  deletedAt         DateTime?

  leads               Lead[]
  claimRequests       ProviderClaimRequest[]
  creditTransactions  LeadCreditTransaction[]
  payments            ProviderPayment[]

  @@map("DieselMechanic")
}

model Lead {
  id               String     @id @default(cuid())
  createdAt        DateTime   @default(now())

  serviceRequestId String
  providerId       String

  status           LeadStatus @default(SENT)
  charged          Boolean    @default(false)
  price            Float      @default(25)

  serviceRequest   ServiceRequest  @relation(fields: [serviceRequestId], references: [id])
  provider         ServiceProvider @relation(fields: [providerId], references: [id])

  @@map("DieselLead")
}

model ProviderClaimRequest {
  id           String             @id @default(cuid())
  createdAt    DateTime           @default(now())

  providerId   String
  businessName String
  contactName  String
  phone        String
  email        String
  notes        String?
  status       ClaimRequestStatus @default(NEW)

  provider     ServiceProvider    @relation(fields: [providerId], references: [id])

  @@map("ProviderClaimRequest")
}

model LeadCreditTransaction {
  id                    String                    @id @default(cuid())
  createdAt             DateTime                  @default(now())
  providerId            String
  amount                Int
  type                  LeadCreditTransactionType
  note                  String?
  stripePaymentIntentId String?
  provider              ServiceProvider           @relation(fields: [providerId], references: [id])

  @@map("LeadCreditTransaction")
}

model ProviderPayment {
  id                    String          @id @default(cuid())
  createdAt             DateTime        @default(now())
  providerId            String
  stripePaymentIntentId String?
  amountCents           Int
  creditsPurchased      Int
  status                String
  provider              ServiceProvider @relation(fields: [providerId], references: [id])

  @@map("ProviderPayment")
}
